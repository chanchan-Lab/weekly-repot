# BotFather에서 발급. 실제 값은 이 파일이 아닌 .env에 입력
TELEGRAM_BOT_TOKEN=
# 처음에는 비워 두고 /whoami로 ID를 확인. 비어 있으면 업무 명령은 차단됨
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
ADMIN_USER_IDS=
# 사용자 ID와 표시 이름. 실제 팀원 명단으로 변경
TEAM_MEMBERS_JSON={"123456789":"최찬"}
# mock: API 없이 원문을 구분해 동작 확인 / openai: AI로 보고 문장 정리
AI_MODE=mock
OPENAI_API_KEY=
# openai 모드 전환 시 계정에서 사용 가능한 Structured Outputs 지원 모델 ID 입력
OPENAI_MODEL=
TZ=Asia/Seoul
DATA_DIR=/app/data
TEMPLATE_PATH=/app/templates/weekly-template.pptx
MAX_INPUT_CHARS=3500
MAX_TEAM_CHARS=30000
